@startuml States
title Order lifecycle

[*] --> Draft
Draft --> Submitted : submit
Submitted --> Paid : payment cleared
Submitted --> Cancelled : timeout
Paid --> Shipped : dispatch
Shipped --> [*]
Cancelled --> [*]

@enduml

